rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Seznam schválených e-mailů štábu, gafferů a administrátorů:
    function isApprovedUser() {
      return request.auth != null && (
        request.auth.token.email in [
          // Hlavní administrátoři a systém:
          'petmatejda@gmail.com',                   // Petr Matějíček (Admin)
          'petr.matejicek@balloonlightgroup.com',   // Petr Matějíček (BLP)
          'admin@balloonlightprag.cz',              // Test Admin (blp)
          'admin@blp.cz',                           // Test Admin (blp)
          
          // Klíčový tým a gaffeři:
          'marekradolf@seznam.cz',                  // Marek Radolf
          'petrradolf@seznam.cz',                   // Petr Radolf
          'jaroslav.hluchy@gmail.com',              // Jarda Hluchý
          'matejus.reznak@seznam.cz',               // Matěj Rezňák
          'kate@k-international.cz',                // Kateřina Ulrichová (Koordinátor)
          
          // Členové štábu a technici:
          'koleczko66@gmail.com',
          'malypavel5@email.cz',
          'blazek.jarous@seznam.cz',
          'cavallo.robin@gmail.com',
          'cavallo.oliver@gmail.com',
          'petr.ji@seznam.cz',
          'auretas@seznam.cz',
          'gkmallas@gmail.com',
          'sejnoha.vaclav1@seznam.cz',
          'marcomatko@gmail.com'
        ]
      );
    }

    // Sdílený sklad, zakázky a technika pro celou aplikaci a štáb:
    match /inventory_store/{document=**} {
      allow read, write: if true;
    }

    // Uživatelské profily:
    match /users/{userId} {
      allow read, write: if true;
    }

    // Ostatní systémové dokumenty podle schváleného štábu:
    match /{document=**} {
      allow read, write: if isApprovedUser();
    }
  }
}
