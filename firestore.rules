rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Seznam všech oprávněných uživatelů a administrátorů BLP:
    function isApprovedAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'petmatejda@gmail.com',
          'petr.matejicek@balloonlightgroup.com',
          'admin@balloonlightprag.cz',
          'admin@blp.cz',
          'marekradolf@seznam.cz',
          'petrradolf@seznam.cz',
          'jaroslav.hluchy@gmail.com',
          'matejus.reznak@seznam.cz',
          'kate@k-international.cz',
          'koleczko66@gmail.com',
          'malypavel5@email.cz',
          'blazek.jarous@seznam.cz',
          'cavallo.robin@gmail.com',
          'cavallo.oliver@gmail.com',
          'petr.ji@seznam.cz',
          'auretas@seznam.cz',
          'gkmallas@gmail.com',
          'sejnoha.vaclav1@seznam.cz',
          'marcomatko@gmail.com'
        ]
      );
    }

    // Sdílený sklad, zakázky a technika:
    match /inventory_store/{document=**} {
      allow read, write: if true;
    }

    // Uživatelské profily:
    match /users/{userId} {
      allow read, write: if true;
    }

    // Ostatní systémové dokumenty:
    match /{document=**} {
      allow read, write: if isApprovedAdmin();
    }
  }
}
