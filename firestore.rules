rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to the shared inventory store and users for authenticated crew or during testing
    match /inventory_store/{document=**} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
