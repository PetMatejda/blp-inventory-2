rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seznam oprávněných uživatelů BLP.
    // Nového člena týmu přidáte tak, že sem doplníte jeho e-mail a pravidla znovu publikujete
    // (Firebase Console → Firestore Database → Rules → Publish).
    function isApprovedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'petmatejda@gmail.com',
          'petr.matejicek@balloonlightgroup.com',
          'admin@balloonlightprag.cz',
          'admin@blp.cz',
          'marekradolf@seznam.cz',
          'petrradolf@seznam.cz',
          'jaroslav.hluchy@gmail.com',
          'matejus.reznak@seznam.cz',
          'kate@k-international.cz',
          'koleczko66@gmail.com',
          'malypavel5@email.cz',
          'blazek.jarous@seznam.cz',
          'cavallo.robin@gmail.com',
          'cavallo.oliver@gmail.com',
          'petr.ji@seznam.cz',
          'auretas@seznam.cz',
          'gkmallas@gmail.com',
          'sejnoha.vaclav1@seznam.cz',
          'marcomatko@gmail.com'
        ];
    }

    // Sdílený sklad, zakázky a technika — jen schválení uživatelé.
    match /inventory_store/{document=**} {
      allow read, write: if isApprovedUser();
    }

    // Uživatelské profily: číst mohou schválení uživatelé, zapisovat jen vlastní profil.
    match /users/{userId} {
      allow read: if isApprovedUser();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ostatní dokumenty — jen schválení uživatelé.
    match /{document=**} {
      allow read, write: if isApprovedUser();
    }
  }
}
