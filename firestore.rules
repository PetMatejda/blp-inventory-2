rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seznam oprávněných uživatelů BLP.
    // Nového člena týmu přidáte tak, že sem doplníte jeho e-mail a pravidla znovu publikujete
    // (Firebase Console → Firestore Database → Rules → Publish).
    function isApprovedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'petmatejda@gmail.com',
          'petr.matejicek@balloonlightgroup.com',
          'admin@balloonlightprag.cz',
          'admin@blp.cz',
          'marekradolf@seznam.cz',
          'petrradolf@seznam.cz',
          'jaroslav.hluchy@gmail.com',
          'matejus.reznak@seznam.cz',
          'kate@k-international.cz',
          'koleczko66@gmail.com',
          'malypavel5@email.cz',
          'blazek.jarous@seznam.cz',
          'cavallo.robin@gmail.com',
          'cavallo.oliver@gmail.com',
          'petr.ji@seznam.cz',
          'auretas@seznam.cz',
          'gkmallas@gmail.com',
          'sejnoha.vaclav1@seznam.cz',
          'marcomatko@gmail.com'
        ];
    }

    // Zakázky, položky, katalog a spotřební materiál (jeden dokument = jeden záznam).
    match /jobs/{id} {
      allow read, write: if isApprovedUser();
    }
    match /jobItems/{id} {
      allow read, write: if isApprovedUser();
    }
    match /catalog/{id} {
      allow read, write: if isApprovedUser();
    }
    match /consumables/{id} {
      allow read, write: if isApprovedUser();
    }

    // Auditní log je neměnný: záznamy se jen přidávají.
    // (Opakovaný zápis stejných dat je povolen kvůli bezpečnému opakování migrace.)
    match /auditLogs/{id} {
      allow read, create: if isApprovedUser();
      allow update: if isApprovedUser() && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Fotky (závady, katalog) jako dokumenty — max. ~1 MB, nepřepisují se.
    match /photos/{id} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1000000
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*');
      allow update, delete: if false;
    }

    // Stav jednorázové migrace dat.
    match /meta/{id} {
      allow read, write: if isApprovedUser();
    }

    // Původní sdílený dokument — po převodu jen pro čtení (záloha).
    // Zápis je zakázán, aby staré verze aplikace nezapisovaly do dat, která už nikdo nečte.
    match /inventory_store/{document=**} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    // Uživatelské profily: číst mohou schválení uživatelé, zapisovat jen vlastní profil.
    match /users/{userId} {
      allow read: if isApprovedUser();
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
