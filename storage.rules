rules_version = '2';
// Pravidla pro Firebase Storage (fotky závad a katalogu).
// Publikace: Firebase Console → Storage → Rules → vložit → Publish.
// Seznam e-mailů musí být STEJNÝ jako ve firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isApprovedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'petmatejda@gmail.com',
          'petr.matejicek@balloonlightgroup.com',
          'admin@balloonlightprag.cz',
          'admin@blp.cz',
          'marekradolf@seznam.cz',
          'petrradolf@seznam.cz',
          'jaroslav.hluchy@gmail.com',
          'matejus.reznak@seznam.cz',
          'kate@k-international.cz',
          'koleczko66@gmail.com',
          'malypavel5@email.cz',
          'blazek.jarous@seznam.cz',
          'cavallo.robin@gmail.com',
          'cavallo.oliver@gmail.com',
          'petr.ji@seznam.cz',
          'auretas@seznam.cz',
          'gkmallas@gmail.com',
          'sejnoha.vaclav1@seznam.cz',
          'marcomatko@gmail.com'
        ];
    }

    // Fotky závad a katalogu: jen obrázky do 5 MB, jen schválení uživatelé.
    match /{folder}/{allPaths=**} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && (folder == 'damage' || folder == 'catalog')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
